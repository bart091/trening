            function archiveAndClearSession() {
                if (currentSets.length > 0) {
                    const totalSets = currentSets.length;
                    const totalVolume = currentSets.reduce((acc, s) => acc + (s.weight * s.reps), 0);

                    const countsMap = new Map();
                    currentSets.forEach(s => {
                        countsMap.set(s.exercise, (countsMap.get(s.exercise) || 0) + 1);
                    });

                    const exercises = Array.from(countsMap.entries()).map(([name, setsCount]) => ({
                        name,
                        setsCount
                    }));

                    const now = new Date();
                    const dateLabel = now.toLocaleDateString('pl-PL', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    workoutHistory.unshift({
                        id: Date.now().toString(),
                        dateLabel,
                        totalSets,
                        totalVolume,
                        exercises
                    });

                    // Zachowaj maksymalnie 20 ostatnich sesji
                    workoutHistory = workoutHistory.slice(0, 20);
                    saveHistoryToStorage();
                }

                currentSets = [];
                saveSetsToStorage();
                stopAndResetTimer();
                renderSets();
                renderHistory();
                renderExerciseChips();
                renderActivePlanBanner();
                closeConfirmModal();
                showToast('Trening zapisany w historii');
            }

            function deleteSessionWithoutArchive() {
                currentSets = [];
                saveSetsToStorage();
                stopAndResetTimer();
                renderSets();
                renderExerciseChips();
                renderActivePlanBanner();
                closeConfirmModal();
                showToast('Wyczyszczono dzisiejszy trening');
            }

            // --- STOPER PRZERWY ---
            function updateTimerDisplay() {
                const mins = Math.floor(timerSeconds / 60);
                const secs = timerSeconds % 60;
                timerDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            }

            function resetAndStartTimer() {
                timerSeconds = 0;
                updateTimerDisplay();
                if (!timerRunning) {
                    startTimer();
                }
            }

            function startTimer() {
                if (timerRunning) return;
                timerRunning = true;
                timerIconPlay.classList.add('hidden');
                timerIconPause.classList.remove('hidden');
                timerDisplay.classList.add('text-lime-400');

                timerInterval = setInterval(() => {
                    timerSeconds++;
                    updateTimerDisplay();
                }, 1000);
            }

            function pauseTimer() {
                timerRunning = false;
                clearInterval(timerInterval);
                timerIconPlay.classList.remove('hidden');
                timerIconPause.classList.add('hidden');
                timerDisplay.classList.remove('text-lime-400');
            }

            function stopAndResetTimer() {
                pauseTimer();
                timerSeconds = 0;
                updateTimerDisplay();
            }

            // --- FUNKCJE POMOCNICZE UI ---
            function openConfirmModal() {
                confirmModal.classList.remove('hidden');
                confirmModal.classList.add('flex');
            }

            function closeConfirmModal() {
                confirmModal.classList.add('hidden');
                confirmModal.classList.remove('flex');
            }

            function showToast(message) {
                toastMsgEl.textContent = message;
                toastEl.classList.remove('opacity-0');
                toastEl.classList.add('opacity-100');

                if (toastTimeout) clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => {
                    toastEl.classList.remove('opacity-100');
                    toastEl.classList.add('opacity-0');
                }, 2000);
            }

            function formatNumber(num) {
                return Number.isInteger(num) ? num.toString() : num.toFixed(1).replace('.0', '');
            }

            function escapeHtml(str) {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // --- NASŁUCHIWANIE ZDARZEŃ ---
            function setupEventListeners() {
                // Zapis serii
                setForm.addEventListener('submit', handleAddSet);

                // Automatyczne zaznaczanie zawartości pola przy dotknięciu (szybkie nadpisywanie)
                [weightInput, repsInput].forEach(input => {
                    input.addEventListener('focus', function () {
                        setTimeout(() => this.select(), 20);
                    });
                });

                exerciseInput.addEventListener('input', () => {
                    toggleClearExerciseButton();
                    renderExerciseChips();
                    renderActivePlanBanner();
                });

                clearExerciseBtn.addEventListener('click', () => {
                    exerciseInput.value = '';
                    toggleClearExerciseButton();
                    renderExerciseChips();
                    renderActivePlanBanner();
                    exerciseInput.focus();
                });

                // Kliknięcie w chip ćwiczenia
                exerciseChipsContainer.addEventListener('click', (e) => {
                    const btn = e.target.closest('[data-chip-exercise]');
                    if (btn) {
                        selectExercise(btn.getAttribute('data-chip-exercise'));
                    }
                });

                // --- ZDARZENIA MODUŁU PLANÓW TRENINGOWYCH ---
                openPlansBtn.addEventListener('click', () => openPlansModal('list'));
                quickLoadPlanBtn.addEventListener('click', () => openPlansModal('list'));
                changePlanBtn.addEventListener('click', () => openPlansModal('list'));
                closePlansModalBtn.addEventListener('click', closePlansModal);

                plansModal.addEventListener('click', (e) => {
                    if (e.target === plansModal) closePlansModal();
                });

                planTabBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        switchPlanModalTab(btn.getAttribute('data-plan-tab'));
                    });
                });

                // Kliknięcie na liście planów (Wczytaj lub Usuń własny plan)
                plansListContainer.addEventListener('click', (e) => {
                    const loadBtn = e.target.closest('[data-load-plan-id]');
                    if (loadBtn) {
                        loadPlanById(loadBtn.getAttribute('data-load-plan-id'));
                        return;
                    }

                    const deleteBtn = e.target.closest('[data-delete-plan-id]');
                    if (deleteBtn) {
                        const delId = deleteBtn.getAttribute('data-delete-plan-id');
                        customPlans = customPlans.filter(p => p.id !== delId);
                        saveCustomPlansToStorage();
                        if (activePlanId === delId) {
                            activePlanId = null;
                            saveActivePlanIdToStorage();
                            renderActivePlanBanner();
                        }
                        renderPlansListInModal();
                        showToast('Usunięto własny plan');
                    }
                });

                // Kliknięcie ćwiczenia na widżecie Aktywnego Planu
                activePlanExercises.addEventListener('click', (e) => {
                    const rowBtn = e.target.closest('[data-plan-exercise-idx]');
                    if (!rowBtn) return;
                    const plan = getActivePlan();
                    if (!plan) return;
                    const idx = parseInt(rowBtn.getAttribute('data-plan-exercise-idx'), 10);
                    const ex = plan.exercises[idx];
                    if (ex) {
                        selectExercise(ex.name, ex.targetReps);
                        showToast(`Wybrano: ${ex.name} (${ex.targetReps} powt.)`);
                    }
                });

                nextPlanExerciseBtn.addEventListener('click', selectNextPlanExercise);

                unloadPlanBtn.addEventListener('click', () => {
                    activePlanId = null;
                    saveActivePlanIdToStorage();
                    renderActivePlanBanner();
                    renderExerciseChips();
                    showToast('Wyłączono aktywny plan');
                });

                // Wstawienie przykładowej rozpiski tekstowej
                fillSamplePlanBtn.addEventListener('click', () => {
                    if (!newPlanNameInput.value.trim()) {
                        newPlanNameInput.value = 'Góra / Dół - Góra A';
                    }
                    newPlanTextInput.value = [
                        'Wyciskanie sztangi leżąc | 4 | 8',
                        'Wiosłowanie sztangą | 4 | 10',
                        'Wyciskanie żołnierskie (OHP) | 3 | 10',
                        'Podciąganie na drążku | 3 | 8',
                        'Wznosy hantli bokiem | 3 | 15',
                        'Uginanie ramion z hantlami (Biceps) | 3 | 12'
                    ].join('\n');
                });

                // Zapisanie nowego własnego planu z tekstu
                saveCustomPlanBtn.addEventListener('click', () => {
                    planCreateError.classList.add('hidden');
                    const name = newPlanNameInput.value.trim();
                    const rawText = newPlanTextInput.value.trim();

                    if (!name) {
                        planCreateError.textContent = 'Podaj nazwę swojego planu treningowego.';
                        planCreateError.classList.remove('hidden');
                        newPlanNameInput.focus();
                        return;
                    }

                    const exercises = parsePlanText(rawText);
                    if (exercises.length === 0) {
                        planCreateError.textContent = 'Wpisz przynajmniej jedno ćwiczenie (jedno w każdej linii).';
                        planCreateError.classList.remove('hidden');
                        newPlanTextInput.focus();
                        return;
                    }

                    const newPlan = {
                        id: 'custom_' + Date.now().toString(36),
                        name,
                        builtin: false,
                        exercises
                    };

                    customPlans.unshift(newPlan);
                    saveCustomPlansToStorage();

                    newPlanNameInput.value = '';
                    newPlanTextInput.value = '';

                    loadPlanById(newPlan.id);
                });

                // Eksport planów do schowka (z fallbackiem execCommand dla iFrame)
                copyPlansJsonBtn.addEventListener('click', () => {
                    const dataStr = JSON.stringify(customPlans.length ? customPlans : getAllPlans(), null, 2);
                    const tempArea = document.createElement('textarea');
                    tempArea.value = dataStr;
                    document.body.appendChild(tempArea);
                    tempArea.select();
                    try {
                        document.execCommand('copy');
                        showToast('Skopiowano plany JSON do schowka');
                    } catch (err) {
                        showToast('Nie udało się skopiować');
                    }
                    document.body.removeChild(tempArea);
                });

                // Pobranie planów jako plik .json
                downloadPlansJsonBtn.addEventListener('click', () => {
                    const dataStr = JSON.stringify(customPlans.length ? customPlans : getAllPlans(), null, 2);
                    const blob = new Blob([dataStr], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'plany-treningowe.json';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    showToast('Pobrano plik plany-treningowe.json');
                });

                // Import planów z wklejonego JSON
                function importPlansFromJsonString(jsonStr) {
                    try {
                        const parsed = JSON.parse(jsonStr);
                        const list = Array.isArray(parsed) ? parsed : [parsed];
                        let added = 0;

                        list.forEach(item => {
                            if (item && item.name && Array.isArray(item.exercises) && item.exercises.length > 0) {
                                customPlans.unshift({
                                    id: 'custom_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 5),
                                    name: String(item.name).trim(),
                                    builtin: false,
                                    exercises: item.exercises.map(ex => ({
                                        name: String(ex.name || 'Ćwiczenie').trim(),
                                        targetSets: parseInt(ex.targetSets, 10) || 3,
                                        targetReps: parseInt(ex.targetReps, 10) || 8
                                    }))
                                });
                                added++;
                            }
                        });

                        if (added > 0) {
                            saveCustomPlansToStorage();
                            importJsonTextarea.value = '';
                            switchPlanModalTab('list');
                            showToast(`Zaimportowano planów: ${added}`);
                        } else {
                            showToast('Nieprawidłowy format planu w JSON');
                        }
                    } catch (err) {
                        showToast('Błąd składni JSON');
                    }
                }

                importJsonBtn.addEventListener('click', () => {
                    const val = importJsonTextarea.value.trim();
                    if (!val) {
                        showToast('Wklej najpierw kod JSON');
                        return;
                    }
                    importPlansFromJsonString(val);
                });

                importJsonFileInput.addEventListener('change', (e) => {
                    const file = e.target.files && e.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        importPlansFromJsonString(ev.target.result);
                        importJsonFileInput.value = '';
                    };
                    reader.readAsText(file);
                });

                // Przyciski krokowe +/- dla ciężaru
                document.querySelectorAll('[data-step-weight]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const delta = parseFloat(btn.getAttribute('data-step-weight'));
                        const current = parseFloat(String(weightInput.value).replace(',', '.')) || 0;
                        const nextVal = Math.max(0, Math.round((current + delta) * 100) / 100);
                        weightInput.value = nextVal;
                    });
                });

                // Przyciski krokowe +/- dla powtórzeń
                document.querySelectorAll('[data-step-reps]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const delta = parseInt(btn.getAttribute('data-step-reps'), 10);
                        const current = parseInt(repsInput.value, 10) || 0;
                        const nextVal = Math.max(1, current + delta);
                        repsInput.value = nextVal;
                    });
                });

                // Przełączanie trybu widoku (Pogrupowane / Chronologicznie)
                viewGroupedBtn.addEventListener('click', () => {
                    viewMode = 'grouped';
                    localStorage.setItem(STORAGE_KEYS.VIEW_MODE, viewMode);
                    updateViewModeButtons();
                    renderSets();
                });

                viewChronoBtn.addEventListener('click', () => {
                    viewMode = 'chrono';
                    localStorage.setItem(STORAGE_KEYS.VIEW_MODE, viewMode);
                    updateViewModeButtons();
                    renderSets();
                });

                // Delegacja zdarzeń w liście serii (usuwanie serii + wybór ćwiczenia po kliknięciu w nagłówek karty)
                setsContainer.addEventListener('click', (e) => {
                    const deleteBtn = e.target.closest('[data-delete-id]');
                    if (deleteBtn) {
                        const id = deleteBtn.getAttribute('data-delete-id');
                        deleteSetById(id);
                        return;
                    }

                    const selectExBtn = e.target.closest('[data-select-exercise]');
                    if (selectExBtn) {
                        const exName = selectExBtn.getAttribute('data-select-exercise');
                        selectExercise(exName);
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                        showToast(`Wybrano: ${exName}`);
                    }
                });

                // Stoper przerwy
                timerToggleBtn.addEventListener('click', () => {
                    if (timerRunning) {
                        pauseTimer();
                    } else {
                        startTimer();
                    }
                });

                timerResetBtn.addEventListener('click', () => {
                    stopAndResetTimer();
                });

                // Modal zakończenia treningu
                finishWorkoutBtn.addEventListener('click', openConfirmModal);
                modalCancelBtn.addEventListener('click', closeConfirmModal);
                modalArchiveBtn.addEventListener('click', archiveAndClearSession);
                modalDeleteBtn.addEventListener('click', deleteSessionWithoutArchive);

                confirmModal.addEventListener('click', (e) => {
                    if (e.target === confirmModal) closeConfirmModal();
                });

                // Czyszczenie historii archiwalnej
                clearHistoryBtn.addEventListener('click', () => {
                    workoutHistory = [];
                    saveHistoryToStorage();
                    renderHistory();
                    showToast('Wyczyszczono historię treningów');
                });
            }

            // Start po załadowaniu DOM
            document.addEventListener('DOMContentLoaded', init);
        })();
    </script>
</body>
</html>
