            // --- CHIPY ĆWICZEŃ I DATALIST ---
            function getCombinedExercisesList() {
                const activePlan = getActivePlan();
                const planExercises = activePlan ? activePlan.exercises.map(e => e.name) : [];
                const recentFromToday = [...new Set(currentSets.map(s => s.exercise))];
                const combined = [...planExercises];

                recentFromToday.forEach(ex => {
                    if (!combined.some(item => item.toLowerCase() === ex.toLowerCase())) {
                        combined.push(ex);
                    }
                });

                DEFAULT_EXERCISES.forEach(ex => {
                    if (!combined.some(item => item.toLowerCase() === ex.toLowerCase())) {
                        combined.push(ex);
                    }
                });
                return combined;
            }

