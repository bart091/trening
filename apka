            function selectExercise(exerciseName, suggestedReps) {
                exerciseInput.value = exerciseName;
                toggleClearExerciseButton();

                const lowerName = exerciseName.trim().toLowerCase();

                // 1. Sprawdź czy w dzisiejszej sesji było już wykonywane to ćwiczenie
                const lastSetForExercise = [...currentSets]
                    .reverse()
                    .find(s => s.exercise.trim().toLowerCase() === lowerName);

                if (lastSetForExercise) {
                    weightInput.value = lastSetForExercise.weight;
                    repsInput.value = suggestedReps !== undefined ? suggestedReps : lastSetForExercise.reps;
                } else {
                    // 2. Jeśli nie dzisiaj, sprawdź zapisany wcześniej ciężar dla tego ćwiczenia w pamięci
                    if (exerciseWeightsMemory[lowerName] !== undefined) {
                        weightInput.value = exerciseWeightsMemory[lowerName];
                    }
                    // 3. Jeśli podano docelowe powtórzenia z planu (lub ćwiczenie jest w aktywnym planie), ustaw je
                    if (suggestedReps !== undefined) {
                        repsInput.value = suggestedReps;
                    } else {
                        const plan = getActivePlan();
                        if (plan) {
                            const foundInPlan = plan.exercises.find(e => e.name.trim().toLowerCase() === lowerName);
                            if (foundInPlan && foundInPlan.targetReps) {
                                repsInput.value = foundInPlan.targetReps;
                            }
                        }
                    }
                }

                renderExerciseChips();
                renderActivePlanBanner();
            }

