                        { name: 'Uginanie ramion z hantlami (Biceps)', targetSets: 2, targetReps: 12 }
                    ]
                },
                {
                    id: 'builtin_fbw_b',
                    name: 'FBW B (Full Body Workout)',
                    builtin: true,
                    exercises: [
                        { name: 'Martwy ciąg', targetSets: 3, targetReps: 6 },
                        { name: 'Wyciskanie hantli na skosie', targetSets: 3, targetReps: 10 },
                        { name: 'Podciąganie na drążku', targetSets: 3, targetReps: 8 },
                        { name: 'Wykroki z hantlami', targetSets: 3, targetReps: 10 },
                        { name: 'Prostowanie ramion na wyciągu (Triceps)', targetSets: 2, targetReps: 12 }
                    ]
                },
                {
                    id: 'builtin_push',
                    name: 'Push (Klatka, Barki, Triceps)',
                    builtin: true,
                    exercises: [
                        { name: 'Wyciskanie sztangi leżąc', targetSets: 4, targetReps: 8 },
                        { name: 'Wyciskanie hantli na skosie', targetSets: 3, targetReps: 10 },
                        { name: 'Wyciskanie żołnierskie (OHP)', targetSets: 3, targetReps: 8 },
                        { name: 'Wznosy hantli bokiem', targetSets: 4, targetReps: 15 },
                        { name: 'Pompki na poręczach (Dipy)', targetSets: 3, targetReps: 10 },
                        { name: 'Prostowanie ramion na wyciągu (Triceps)', targetSets: 3, targetReps: 12 }
                    ]
                },
                {
                    id: 'builtin_pull',
                    name: 'Pull (Plecy, Tył barku, Biceps)',
                    builtin: true,
                    exercises: [
                        { name: 'Martwy ciąg', targetSets: 3, targetReps: 5 },
                        { name: 'Podciąganie na drążku', targetSets: 4, targetReps: 8 },
                        { name: 'Wiosłowanie sztangą', targetSets: 3, targetReps: 10 },
                        { name: 'Ściąganie drążka wyciągu górnego', targetSets: 3, targetReps: 12 },
                        { name: 'Uginanie ramion z hantlami (Biceps)', targetSets: 4, targetReps: 12 }
                    ]
                }
            ];

            // Domyślna baza najpopularniejszych ćwiczeń FBW / Siłownia po polsku
            const DEFAULT_EXERCISES = [
                'Wyciskanie sztangi leżąc',
                'Przysiad ze sztangą',
                'Martwy ciąg',
                'Podciąganie na drążku',
                'Wyciskanie żołnierskie (OHP)',
                'Wiosłowanie sztangą',
                'Wykroki z hantlami',
                'Pompki na poręczach (Dipy)',
                'Wyciskanie hantli na skosie',
                'Ściąganie drążka wyciągu górnego',
                'Hip Thrust ze sztangą',
                'Wznosy hantli bokiem',
                'Uginanie ramion z hantlami (Biceps)',
                'Prostowanie ramion na wyciągu (Triceps)'
            ];

            // Stan aplikacji
            let currentSets = [];
            let workoutHistory = [];
            let viewMode = 'grouped'; // 'grouped' | 'chrono'
            let customPlans = [];
            let activePlanId = null;
            let exerciseWeightsMemory = {}; // Pamięć ostatniego ciężaru dla każdego ćwiczenia

            // Stan stopera przerwy
            let timerSeconds = 0;
            let timerInterval = null;
            let timerRunning = false;

            // Referencje DOM
            const currentDateEl = document.getElementById('current-date');
            const statSetsEl = document.getElementById('stat-sets');
            const statVolumeEl = document.getElementById('stat-volume');

            const openPlansBtn = document.getElementById('open-plans-btn');
            const quickLoadPlanBtn = document.getElementById('quick-load-plan-btn');
            const noPlanBar = document.getElementById('no-plan-bar');
            const activePlanBanner = document.getElementById('active-plan-banner');
            const activePlanTitle = document.getElementById('active-plan-title');
            const activePlanProgressBadge = document.getElementById('active-plan-progress-badge');
            const activePlanProgressBar = document.getElementById('active-plan-progress-bar');
            const activePlanExercises = document.getElementById('active-plan-exercises');
            const nextPlanExerciseBtn = document.getElementById('next-plan-exercise-btn');
            const changePlanBtn = document.getElementById('change-plan-btn');
            const unloadPlanBtn = document.getElementById('unload-plan-btn');

            const plansModal = document.getElementById('plans-modal');
            const closePlansModalBtn = document.getElementById('close-plans-modal-btn');
            const planTabBtns = document.querySelectorAll('.plan-tab-btn');
            const planTabList = document.getElementById('plan-tab-list');
            const planTabCreate = document.getElementById('plan-tab-create');
            const planTabBackup = document.getElementById('plan-tab-backup');
            const plansListContainer = document.getElementById('plans-list-container');
            const newPlanNameInput = document.getElementById('new-plan-name');
            const newPlanTextInput = document.getElementById('new-plan-text');
            const fillSamplePlanBtn = document.getElementById('fill-sample-plan-btn');
            const planCreateError = document.getElementById('plan-create-error');
            const saveCustomPlanBtn = document.getElementById('save-custom-plan-btn');
            const copyPlansJsonBtn = document.getElementById('copy-plans-json-btn');
            const downloadPlansJsonBtn = document.getElementById('download-plans-json-btn');
            const importJsonFileInput = document.getElementById('import-json-file-input');
            const importJsonTextarea = document.getElementById('import-json-textarea');
            const importJsonBtn = document.getElementById('import-json-btn');

            const setForm = document.getElementById('set-form');
            const exerciseInput = document.getElementById('exercise-input');
            const clearExerciseBtn = document.getElementById('clear-exercise-btn');
            const exercisesDatalist = document.getElementById('exercises-datalist');
            const exerciseChipsContainer = document.getElementById('exercise-chips');
            const weightInput = document.getElementById('weight-input');
            const repsInput = document.getElementById('reps-input');
            const formError = document.getElementById('form-error');
            const saveSetBtn = document.getElementById('save-set-btn');

            const viewGroupedBtn = document.getElementById('view-grouped-btn');
            const viewChronoBtn = document.getElementById('view-chrono-btn');
            const setsContainer = document.getElementById('sets-container');
            const workoutActions = document.getElementById('workout-actions');
            const finishWorkoutBtn = document.getElementById('finish-workout-btn');

            const historySection = document.getElementById('history-section');
            const historyCountEl = document.getElementById('history-count');
            const historyListEl = document.getElementById('history-list');
            const clearHistoryBtn = document.getElementById('clear-history-btn');

            const confirmModal = document.getElementById('confirm-modal');
            const modalArchiveBtn = document.getElementById('modal-archive-btn');
            const modalDeleteBtn = document.getElementById('modal-delete-btn');
            const modalCancelBtn = document.getElementById('modal-cancel-btn');

            const timerDisplay = document.getElementById('timer-display');
            const timerToggleBtn = document.getElementById('timer-toggle-btn');
            const timerResetBtn = document.getElementById('timer-reset-btn');
            const timerIconPlay = document.getElementById('timer-icon-play');
            const timerIconPause = document.getElementById('timer-icon-pause');

            const toastEl = document.getElementById('toast');
            const toastMsgEl = document.getElementById('toast-msg');
            let toastTimeout = null;

            // --- INICJALIZACJA ---
            function init() {
                renderCurrentDate();
                loadFromStorage();
                populateDatalist();
                renderExerciseChips();
                renderActivePlanBanner();
                updateViewModeButtons();
                renderSets();
                renderHistory();
                setupEventListeners();
            }

            function renderCurrentDate() {
                const now = new Date();
                const formatted = now.toLocaleDateString('pl-PL', {
                    weekday: 'short',
                    day: '2-digit',
                    month: '2-digit'
                });
                currentDateEl.textContent = formatted;
            }

            // --- OBSŁUGA LOCALSTORAGE ---
            function loadFromStorage() {
                try {
                    const savedSets = localStorage.getItem(STORAGE_KEYS.CURRENT_SETS);
                    if (savedSets) {
                        currentSets = JSON.parse(savedSets);
                    }

                    const savedCustomPlans = localStorage.getItem(STORAGE_KEYS.CUSTOM_PLANS);
                    if (savedCustomPlans) {
                        customPlans = JSON.parse(savedCustomPlans);
                    }

                    const savedActivePlanId = localStorage.getItem(STORAGE_KEYS.ACTIVE_PLAN_ID);
                    if (savedActivePlanId) {
                        activePlanId = savedActivePlanId;
                    }

                    const savedWeights = localStorage.getItem(STORAGE_KEYS.EXERCISE_WEIGHTS);
                    if (savedWeights) {
                        exerciseWeightsMemory = JSON.parse(savedWeights);
                    }

                    const savedLast = localStorage.getItem(STORAGE_KEYS.LAST_INPUTS);
                    if (savedLast) {
                        const last = JSON.parse(savedLast);
                        exerciseInput.value = last.exercise || 'Wyciskanie sztangi leżąc';
                        weightInput.value = last.weight !== undefined ? last.weight : 60;
                        repsInput.value = last.reps !== undefined ? last.reps : 8;
                    } else {
                        // Wartości startowe przy pierwszym uruchomieniu
                        exerciseInput.value = 'Wyciskanie sztangi leżąc';
                        weightInput.value = 60;
                        repsInput.value = 8;
                    }

                    const savedView = localStorage.getItem(STORAGE_KEYS.VIEW_MODE);
                    if (savedView === 'grouped' || savedView === 'chrono') {
                        viewMode = savedView;
                    }

                    const savedHistory = localStorage.getItem(STORAGE_KEYS.HISTORY);
                    if (savedHistory) {
                        workoutHistory = JSON.parse(savedHistory);
                    }
                } catch (e) {
                    console.error('Błąd odczytu danych z localStorage:', e);
                }
                toggleClearExerciseButton();
            }

            function saveSetsToStorage() {
                try {
                    localStorage.setItem(STORAGE_KEYS.CURRENT_SETS, JSON.stringify(currentSets));
                } catch (e) {
                    console.error('Błąd zapisu serii w localStorage:', e);
                }
            }

            function saveLastInputsToStorage(exercise, weight, reps) {
                try {
                    localStorage.setItem(
                        STORAGE_KEYS.LAST_INPUTS,
                        JSON.stringify({ exercise, weight, reps })
                    );
                    if (exercise) {
                        exerciseWeightsMemory[exercise.trim().toLowerCase()] = weight;
                        localStorage.setItem(STORAGE_KEYS.EXERCISE_WEIGHTS, JSON.stringify(exerciseWeightsMemory));
                    }
                } catch (e) {
                    console.error('Błąd zapisu ostatnich wartości:', e);
                }
            }

            function saveCustomPlansToStorage() {
                try {
                    localStorage.setItem(STORAGE_KEYS.CUSTOM_PLANS, JSON.stringify(customPlans));
                } catch (e) {
                    console.error('Błąd zapisu własnych planów:', e);
                }
            }

            function saveActivePlanIdToStorage() {
                try {
                    if (activePlanId) {
                        localStorage.setItem(STORAGE_KEYS.ACTIVE_PLAN_ID, activePlanId);
                    } else {
                        localStorage.removeItem(STORAGE_KEYS.ACTIVE_PLAN_ID);
                    }
                } catch (e) {
                    console.error('Błąd zapisu aktywnego planu:', e);
                }
            }

            function saveHistoryToStorage() {
                try {
                    localStorage.setItem(STORAGE_KEYS.HISTORY, JSON.stringify(workoutHistory));
                } catch (e) {
                    console.error('Błąd zapisu historii:', e);
                }
            }

            // --- OBSŁUGA PLANÓW TRENINGOWYCH ---
            function getAllPlans() {
                return [...customPlans, ...BUILTIN_PLANS];
            }

            function getActivePlan() {
                if (!activePlanId) return null;
                return getAllPlans().find(p => p.id === activePlanId) || null;
            }

            function countTodaySetsForExercise(exerciseName) {
                const target = exerciseName.trim().toLowerCase();
                return currentSets.filter(s => s.exercise.trim().toLowerCase() === target).length;
            }

            function renderActivePlanBanner() {
                const plan = getActivePlan();
                if (!plan) {
                    activePlanBanner.classList.add('hidden');
                    noPlanBar.classList.remove('hidden');
                    return;
                }

                noPlanBar.classList.add('hidden');
                activePlanBanner.classList.remove('hidden');
                activePlanTitle.textContent = plan.name;

                const currentExerciseVal = exerciseInput.value.trim().toLowerCase();
                let totalTargetSets = 0;
                let completedTargetSets = 0;

                const itemsHtml = plan.exercises.map((ex, idx) => {
                    const doneSets = countTodaySetsForExercise(ex.name);
                    const targetSets = ex.targetSets || 3;
                    const targetReps = ex.targetReps || 8;

                    totalTargetSets += targetSets;
                    completedTargetSets += Math.min(doneSets, targetSets);

                    const isCompleted = doneSets >= targetSets;
                    const isSelected = ex.name.trim().toLowerCase() === currentExerciseVal;

                    let rowClasses = 'bg-zinc-950/75 border-zinc-800/90 text-zinc-200 hover:border-zinc-700';
                    if (isSelected) {
                        rowClasses = 'bg-lime-400/15 border-lime-400 text-white ring-1 ring-lime-400/40';
                    } else if (isCompleted) {
                        rowClasses = 'bg-zinc-950/40 border-zinc-800/50 text-zinc-400';
                    }

                    const statusBadge = isCompleted
                        ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-lime-400/20 text-lime-400 font-mono text-xs font-bold border border-lime-400/30">
                               <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                   <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                               </svg>
                               ${doneSets}/${targetSets}
                           </span>`
                        : `<span class="px-2 py-0.5 rounded-lg bg-zinc-900 text-zinc-300 font-mono text-xs font-bold border border-zinc-800">
                               ${doneSets}/${targetSets} s.
                           </span>`;

                    return `
                        <button type="button" data-plan-exercise-idx="${idx}"
                            class="w-full flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl border text-left transition-all active-press ${rowClasses}">
                            <div class="min-w-0 flex-1 flex items-center gap-2">
                                <span class="w-5 h-5 rounded-md bg-zinc-900 border border-zinc-800 text-[11px] font-mono font-bold text-zinc-400 flex items-center justify-center shrink-0">
                                    ${idx + 1}
                                </span>
                                <div class="min-w-0">
                                    <span class="block text-xs font-bold truncate ${isCompleted && !isSelected ? 'line-through text-zinc-400' : ''}">
                                        ${escapeHtml(ex.name)}
                                    </span>
                                    <span class="block text-[10px] font-mono text-zinc-400">
                                        Cel: ${targetSets} serie × ${targetReps} powt.
                                    </span>
                                </div>
                            </div>
                            <div class="shrink-0 flex items-center gap-1.5">
                                ${statusBadge}
                            </div>
                        </button>
                    `;
                }).join('');

                activePlanExercises.innerHTML = itemsHtml;
                activePlanProgressBadge.textContent = `${completedTargetSets}/${totalTargetSets} serii`;
                const pct = totalTargetSets > 0 ? Math.min(100, Math.round((completedTargetSets / totalTargetSets) * 100)) : 0;
                activePlanProgressBar.style.width = `${pct}%`;
            }

            function loadPlanById(planId) {
                const plan = getAllPlans().find(p => p.id === planId);
                if (!plan) return;

                activePlanId = plan.id;
                saveActivePlanIdToStorage();

                // Wybierz pierwsze nieukończone ćwiczenie z planu (lub pierwsze na liście)
                const firstIncomplete = plan.exercises.find(ex => countTodaySetsForExercise(ex.name) < (ex.targetSets || 3)) || plan.exercises[0];
                if (firstIncomplete) {
                    selectExercise(firstIncomplete.name, firstIncomplete.targetReps);
                }

                populateDatalist();
                renderExerciseChips();
                renderActivePlanBanner();
                closePlansModal();
                showToast(`Wczytano plan: ${plan.name}`);
