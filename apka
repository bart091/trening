                                    ${sets.length} ${sets.length === 1 ? 'seria' : (sets.length < 5 ? 'serie' : 'serii')} • <strong class="text-zinc-200">${formatNumber(groupVolume)} kg</strong>
                                </span>
                            </div>
                            <div class="space-y-1.5">
                                ${rowsHtml}
