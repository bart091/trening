            // --- DODAWANIE I USUWANIE SERII ---
            function handleAddSet(e) {
                e.preventDefault();
                formError.classList.add('hidden');

                const exercise = exerciseInput.value.trim();
                const weightStr = String(weightInput.value).replace(',', '.');
                const weight = parseFloat(weightStr);
                const reps = parseInt(repsInput.value, 10);

                if (!exercise) {
                    showFormError('Wpisz lub wybierz nazwę ćwiczenia.');
                    exerciseInput.focus();
                    return;
                }
                if (isNaN(weight) || weight < 0) {
                    showFormError('Podaj prawidłowy ciężar (minimum 0 kg).');
                    weightInput.focus();
                    return;
                }
                if (isNaN(reps) || reps < 1) {
                    showFormError('Podaj liczbę powtórzeń (minimum 1).');
                    repsInput.focus();
                    return;
                }

                const now = new Date();
                const timeString = now.toLocaleTimeString('pl-PL', {
                    hour: '2-digit',
                    minute: '2-digit'
                });

                const newSet = {
                    id: Date.now().toString(36) + Math.random().toString(36).substring(2, 6),
                    exercise,
                    weight: Math.round(weight * 100) / 100,
                    reps,
                    timestamp: Date.now(),
                    time: timeString
                };

                currentSets.push(newSet);
                saveSetsToStorage();
                saveLastInputsToStorage(exercise, newSet.weight, newSet.reps);

                // Ergonomia: zachowaj wpisane wartości w formularzu dla kolejnej serii
                exerciseInput.value = exercise;
                weightInput.value = newSet.weight;
                repsInput.value = newSet.reps;

                populateDatalist();
                renderExerciseChips();
                renderActivePlanBanner();
                renderSets();

                // Automatycznie zresetuj i uruchom stoper przerwy
                resetAndStartTimer();

                // Krótki komunikat potwierdzający
                showToast(`Zapisano: ${ newSet.weight } kg × ${ newSet.reps } powt.`);
            }

            function deleteSetById(setId) {
                const index = currentSets.findIndex(s => s.id === setId);
                if (index !== -1) {
                    const removed = currentSets[index];
                    currentSets.splice(index, 1);
                    saveSetsToStorage();
                    renderExerciseChips();
                    renderActivePlanBanner();
                    renderSets();
                    showToast(`Usunięto serię (${removed.exercise})`);
                }
            }

