    <!-- LOGIKA APLIKACJI (Vanilla JS) -->
    <script>
        (function () {
            'use strict';

            // Klucze localStorage
            const STORAGE_KEYS = {
                CURRENT_SETS: 'gym_logger_current_sets_v1',
                LAST_INPUTS: 'gym_logger_last_inputs_v1',
                VIEW_MODE: 'gym_logger_view_mode_v1',
                HISTORY: 'gym_logger_history_v1',
                CUSTOM_PLANS: 'gym_logger_custom_plans_v1',
                ACTIVE_PLAN_ID: 'gym_logger_active_plan_id_v1',
                EXERCISE_WEIGHTS: 'gym_logger_exercise_weights_v1'
            };

            // Wbudowane gotowe szablony treningowe na start
            const BUILTIN_PLANS = [
                {
                    id: 'builtin_fbw_a',
                    name: 'FBW A (Full Body Workout)',
                    builtin: true,
                    exercises: [
                        { name: 'Przysiad ze sztangą', targetSets: 3, targetReps: 8 },
