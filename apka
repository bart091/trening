<!DOCTYPE html>
<html lang="pl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Szybki Dziennik Treningowy</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        zinc: {
                            850: '#1f1f22',
                            925: '#121214',
                            950: '#09090b',
                        },
                        lime: {
                            450: '#a3e635',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Zapobieganie przybliżaniu na iOS (rozmiar czcionki >= 16px) oraz optymalizacja pod dotyk */
        input, button, select, textarea {
            font-size: 16px !important;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }

        /* Ukrycie domyślnych strzałek w polach numerycznych */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }

        /* Ukrycie paska przewijania dla poziomych chipów przy zachowaniu płynnego przewijania */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Delikatna animacja pojawiania się nowych elementów */
        @keyframes slideDownFade {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .animate-entry {
            animation: slideDownFade 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Efekt wciśnięcia przycisku */
        .active-press:active {
            transform: scale(0.97);
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen pb-16 selection:bg-lime-400 selection:text-zinc-950 antialiased">

    <!-- GŁÓWNY KONTENER MOBILNY -->
    <div class="max-w-md mx-auto min-h-screen flex flex-col">

        <!-- 1. PRZYLEPNY NAGŁÓWEK ZE STATYSTYKAMI I STOPEREM PRZERWY -->
        <header class="sticky top-0 z-30 bg-zinc-950/90 backdrop-blur-md border-b border-zinc-800/80 px-4 py-3">
            <div class="flex items-center justify-between gap-2">
                <!-- Tytuł i dzisiejsza data -->
                <div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-lime-400 animate-pulse"></span>
                        <h1 class="text-base font-extrabold tracking-tight text-white uppercase">Trening</h1>
                        <span id="current-date" class="text-xs font-medium text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded-md border border-zinc-800"></span>
                    </div>
                    <!-- Podsumowanie na żywo -->
                    <div class="flex items-center gap-3 mt-1 text-xs text-zinc-400">
                        <span>Serie: <strong id="stat-sets" class="text-zinc-100 font-mono">0</strong></span>
                        <span>•</span>
                        <span>Objętość: <strong id="stat-volume" class="text-lime-400 font-mono">0 kg</strong></span>
                    </div>
                </div>

                <!-- Prawa strona nagłówka: Przycisk Planów + Mini Stoper Przerwy -->
                <div class="flex items-center gap-1.5">
                    <!-- Przycisk otwierający moduł Planów Treningowych -->
                    <button id="open-plans-btn" type="button" title="Plany treningowe"
                        class="h-11 px-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 active:bg-zinc-700 border border-zinc-800 flex items-center gap-1.5 text-xs font-bold text-zinc-200 transition-all active-press shadow-inner">
                        <svg class="w-4 h-4 text-lime-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                        <span>Plany</span>
                    </button>

                    <!-- Mini Stoper Przerwy (automatycznie startuje po zapisaniu serii) -->
                    <div class="flex items-center bg-zinc-900 border border-zinc-800 rounded-xl p-1.5 shadow-inner">
                        <div class="px-2 text-right">
                            <span class="block text-[10px] uppercase tracking-wider text-zinc-400 font-semibold leading-none">Przerwa</span>
                            <span id="timer-display" class="font-mono text-sm font-bold text-zinc-200 tracking-tight">00:00</span>
                        </div>
                        <div class="flex items-center gap-1 pl-1 border-l border-zinc-800">
                            <button id="timer-toggle-btn" type="button" title="Start / Pauza"
                                class="w-8 h-8 rounded-lg bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 flex items-center justify-center text-zinc-200 transition-colors">
                                <!-- Ikona Play/Pause dynamicznie podmieniana -->
                                <svg id="timer-icon-play" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                                </svg>
                                <svg id="timer-icon-pause" class="w-4 h-4 hidden text-lime-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <button id="timer-reset-btn" type="button" title="Resetuj stoper"
                                class="w-8 h-8 rounded-lg bg-zinc-800/60 hover:bg-zinc-700 active:bg-zinc-600 flex items-center justify-center text-zinc-400 hover:text-zinc-200 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- GŁÓWNA ZAWARTOŚĆ -->
        <main class="flex-1 px-4 pt-4 space-y-5">

            <!-- 1.5 INTERAKTYWNY WIDŻET AKTYWNEGO PLANU TRENINGOWEGO -->
            <section id="active-plan-banner" aria-label="Aktywny plan treningowy" class="hidden bg-zinc-900/95 border border-lime-400/40 rounded-2xl p-3.5 shadow-xl space-y-3 animate-entry">
                <div class="flex items-center justify-between gap-2">
                    <div class="min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md bg-lime-400/15 text-lime-400 border border-lime-400/30">
                                Aktywny Plan
                            </span>
                            <span id="active-plan-progress-badge" class="text-xs font-mono font-bold text-zinc-400">0/0</span>
                        </div>
                        <h2 id="active-plan-title" class="text-sm font-extrabold text-white truncate mt-1"></h2>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0">
                        <button type="button" id="next-plan-exercise-btn" title="Przejdź do kolejnego nieukończonego ćwiczenia"
                            class="h-9 px-2.5 rounded-xl bg-lime-400 hover:bg-lime-300 text-zinc-950 font-extrabold text-xs flex items-center gap-1 transition-all active-press">
                            <span>Następne</span>
                            <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                        <button type="button" id="change-plan-btn" title="Zmień lub wyłącz plan"
                            class="h-9 w-9 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 flex items-center justify-center border border-zinc-700/60 transition-all active-press">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                            </svg>
                        </button>
                        <button type="button" id="unload-plan-btn" title="Wyłącz aktywny plan"
                            class="h-9 w-9 rounded-xl bg-zinc-800/70 hover:bg-red-950/60 text-zinc-400 hover:text-red-300 flex items-center justify-center border border-zinc-800 transition-all active-press">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Pasek postępu planu -->
                <div class="w-full h-1.5 bg-zinc-950 rounded-full overflow-hidden border border-zinc-800/80">
                    <div id="active-plan-progress-bar" class="h-full bg-lime-400 transition-all duration-300" style="width: 0%"></div>
                </div>

                <!-- Lista ćwiczeń z planu -->
                <div id="active-plan-exercises" class="grid grid-cols-1 gap-1.5 max-h-56 overflow-y-auto pr-0.5">
                    <!-- Wypełniane dynamicznie przez JS -->
                </div>
            </section>

            <!-- Pasek zachęty do wczytania planu, gdy żaden plan nie jest aktywny -->
            <div id="no-plan-bar" class="flex items-center justify-between bg-zinc-900/50 border border-zinc-800/80 rounded-xl px-3.5 py-2.5">
                <div class="flex items-center gap-2.5 min-w-0">
                    <svg class="w-4 h-4 text-lime-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <span class="text-xs text-zinc-400 truncate">Trenujesz według rozpiski?</span>
                </div>
                <button type="button" id="quick-load-plan-btn" class="text-xs font-bold text-lime-400 hover:text-lime-300 shrink-0 pl-2 py-0.5">
                    Wczytaj plan →
                </button>
            </div>

            <!-- 2. FORMULARZ SZYBKIEGO DODAWANIA SERII -->
            <section aria-label="Dodaj nową serię" class="bg-zinc-900/90 border border-zinc-800/90 rounded-2xl p-4 shadow-xl">
                <form id="set-form" class="space-y-4" autocomplete="off">
                    
                    <!-- Wybór / wpisanie ćwiczenia -->
                    <div>
                        <div class="flex justify-between items-center mb-1.5">
                            <label for="exercise-input" class="text-xs font-bold uppercase tracking-wider text-zinc-400">
                                Ćwiczenie
                            </label>
                            <button type="button" id="clear-exercise-btn" class="text-xs text-zinc-500 hover:text-zinc-300 hidden py-0.5 px-1.5 rounded">
                                Wyczyść pole
                            </button>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="text" 
                                id="exercise-input" 
                                list="exercises-datalist"
                                placeholder="Wybierz poniżej lub wpisz własne..." 
                                required
                                class="w-full h-12 px-3.5 bg-zinc-950 border border-zinc-700/80 rounded-xl text-white placeholder-zinc-500 font-medium focus:outline-none focus:border-lime-400 focus:ring-1 focus:ring-lime-400 transition-all"
                            >
                            <datalist id="exercises-datalist"></datalist>
                        </div>

                        <!-- Pasek szybkiego wyboru ćwiczeń (Chipy) -->
                        <div class="mt-2.5">
                            <div id="exercise-chips" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1">
                                <!-- Chipy generowane dynamicznie w JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Wiersz: Ciężar (kg) oraz Powtórzenia -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        
                        <!-- Kontrolka: Ciężar (kg) -->
                        <div class="bg-zinc-950/70 p-2.5 rounded-xl border border-zinc-800/80">
                            <label for="weight-input" class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2 text-center">
                                Ciężar <span class="text-zinc-500 font-normal">(kg)</span>
                            </label>
                            <div class="flex items-center gap-1.5">
                                <button type="button" data-step-weight="-2.5" 
                                    class="h-12 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-zinc-200 font-mono font-bold text-sm transition-all active-press select-none shrink-0 border border-zinc-700/50">
                                    -2.5
                                </button>
                                <input 
                                    type="number" 
                                    id="weight-input" 
                                    step="0.5" 
                                    min="0" 
                                    max="999"
                                    inputmode="decimal" 
                                    placeholder="0"
                                    required
                                    class="w-full h-12 bg-zinc-900 border border-zinc-700/80 rounded-xl text-center font-mono text-xl font-bold text-white focus:outline-none focus:border-lime-400 focus:ring-1 focus:ring-lime-400"
                                >
                                <button type="button" data-step-weight="2.5" 
                                    class="h-12 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-lime-400 font-mono font-bold text-sm transition-all active-press select-none shrink-0 border border-zinc-700/50">
                                    +2.5
                                </button>
                            </div>
                        </div>

                        <!-- Kontrolka: Powtórzenia -->
                        <div class="bg-zinc-950/70 p-2.5 rounded-xl border border-zinc-800/80">
                            <label for="reps-input" class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2 text-center">
                                Powtórzenia
                            </label>
                            <div class="flex items-center gap-1.5">
                                <button type="button" data-step-reps="-1" 
                                    class="h-12 w-12 rounded-xl bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-zinc-200 font-mono font-bold text-lg transition-all active-press select-none shrink-0 border border-zinc-700/50">
                                    -1
                                </button>
                                <input 
                                    type="number" 
                                    id="reps-input" 
                                    step="1" 
                                    min="1" 
                                    max="999"
                                    inputmode="numeric" 
                                    placeholder="0"
                                    required
                                    class="w-full h-12 bg-zinc-900 border border-zinc-700/80 rounded-xl text-center font-mono text-xl font-bold text-white focus:outline-none focus:border-lime-400 focus:ring-1 focus:ring-lime-400"
                                >
                                <button type="button" data-step-reps="1" 
                                    class="h-12 w-12 rounded-xl bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-lime-400 font-mono font-bold text-lg transition-all active-press select-none shrink-0 border border-zinc-700/50">
                                    +1
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Komunikat walidacji (jeśli potrzebny) -->
                    <p id="form-error" class="text-xs text-red-400 font-medium hidden text-center"></p>

                    <!-- Główny przycisk zapisu serii -->
                    <button 
                        type="submit" 
                        id="save-set-btn"
                        class="w-full h-14 bg-lime-400 hover:bg-lime-300 active:bg-lime-500 text-zinc-950 font-extrabold text-base uppercase tracking-wide rounded-xl shadow-lg shadow-lime-400/10 flex items-center justify-center gap-2 transition-all active-press select-none">
                        <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>Zapisz serię</span>
                    </button>
                </form>
            </section>

            <!-- 3. WIDOK BIEŻĄCEGO TRENINGU (DZISIEJSZA SESJA) -->
            <section aria-label="Dzisiejsza sesja" class="space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-extrabold uppercase tracking-wider text-zinc-300 flex items-center gap-2">
                        <span>Dzisiejsza sesja</span>
                    </h2>

                    <!-- Przełącznik widoku: Pogrupowane / Chronologicznie -->
                    <div class="inline-flex bg-zinc-900 p-1 rounded-xl border border-zinc-800 text-xs font-semibold">
                        <button type="button" id="view-grouped-btn" class="px-2.5 py-1.5 rounded-lg bg-zinc-800 text-lime-400 transition-all">
                            Pogrupowane
                        </button>
                        <button type="button" id="view-chrono-btn" class="px-2.5 py-1.5 rounded-lg text-zinc-400 hover:text-zinc-200 transition-all">
                            Chronologicznie
                        </button>
                    </div>
                </div>

                <!-- Kontener na listę serii -->
                <div id="sets-container" class="space-y-3">
                    <!-- Wypełniane dynamicznie przez JS -->
                </div>

                <!-- Przycisk zakończenia / wyczyszczenia dzisiejszego treningu -->
                <div id="workout-actions" class="pt-4 hidden">
                    <button 
                        type="button" 
                        id="finish-workout-btn"
                        class="w-full h-12 bg-zinc-900 hover:bg-zinc-800 active:bg-zinc-700 text-zinc-300 hover:text-white font-semibold text-sm rounded-xl border border-zinc-800 flex items-center justify-center gap-2 transition-all active-press">
                        <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Zakończ / Wyczyść trening</span>
                    </button>
                </div>
            </section>

            <!-- 4. ARCHIWUM OSTATNICH TRENINGÓW (ZWinięte domyślnie) -->
            <section id="history-section" class="pt-2 border-t border-zinc-900 hidden">
                <details class="group bg-zinc-900/50 border border-zinc-800/70 rounded-2xl overflow-hidden">
                    <summary class="flex items-center justify-between px-4 py-3.5 cursor-pointer select-none text-xs font-bold uppercase tracking-wider text-zinc-400 hover:text-zinc-200">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>Historia ostatnich treningów (<span id="history-count">0</span>)</span>
                        </div>
                        <svg class="w-4 h-4 text-zinc-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>
                    <div class="px-4 pb-4 pt-1 space-y-3 border-t border-zinc-800/60">
                        <div id="history-list" class="space-y-2.5 max-h-80 overflow-y-auto pr-1">
                            <!-- Wypełniane przez JS -->
                        </div>
                        <button type="button" id="clear-history-btn" class="text-xs text-red-400/80 hover:text-red-400 underline pt-1 block ml-auto">
                            Wyczyść całą historię
                        </button>
                    </div>
                </details>
            </section>

        </main>
    </div>

    <!-- MODAL ZARZĄDZANIA I WCZYTYWANIA PLANÓW TRENINGOWYCH -->
    <div id="plans-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-xs hidden items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-zinc-900 border-t sm:border border-zinc-800 rounded-t-3xl sm:rounded-2xl max-w-md w-full max-h-[90vh] flex flex-col shadow-2xl animate-entry">
            
            <!-- Nagłówek modala -->
            <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-800">
                <div>
                    <h3 class="text-base font-extrabold text-white uppercase tracking-tight">Plany Treningowe</h3>
                    <p class="text-xs text-zinc-400">Wybierz gotowy szablon lub wklej własną rozpiskę</p>
                </div>
                <button type="button" id="close-plans-modal-btn" aria-label="Zamknij"
                    class="w-9 h-9 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Nawigacja zakładek wewnątrz modala -->
            <div class="grid grid-cols-3 gap-1 bg-zinc-950 p-1.5 mx-5 mt-3 rounded-xl border border-zinc-800 text-xs font-bold">
                <button type="button" data-plan-tab="list" class="plan-tab-btn py-2 rounded-lg bg-zinc-800 text-lime-400 transition-all">
                    Wybierz plan
                </button>
                <button type="button" data-plan-tab="create" class="plan-tab-btn py-2 rounded-lg text-zinc-400 hover:text-zinc-200 transition-all">
                    + Własny plan
                </button>
                <button type="button" data-plan-tab="backup" class="plan-tab-btn py-2 rounded-lg text-zinc-400 hover:text-zinc-200 transition-all">
                    Import / Eksport
                </button>
            </div>

            <!-- Zawartość zakładek (przewijana) -->
            <div class="flex-1 overflow-y-auto p-5 space-y-4">
                
                <!-- ZAKŁADKA 1: LISTA PLANÓW (Szablony + Własne) -->
                <div id="plan-tab-list" class="space-y-3">
                    <div id="plans-list-container" class="space-y-2.5">
