            function selectNextPlanExercise() {
                const plan = getActivePlan();
                if (!plan || !plan.exercises.length) return;

                const currentName = exerciseInput.value.trim().toLowerCase();
                const currentIndex = plan.exercises.findIndex(e => e.name.trim().toLowerCase() === currentName);

                // Szukaj kolejnego nieukończonego ćwiczenia po aktualnym
                for (let i = 1; i <= plan.exercises.length; i++) {
                    const candidate = plan.exercises[(currentIndex + i) % plan.exercises.length];
                    if (countTodaySetsForExercise(candidate.name) < (candidate.targetSets || 3)) {
                        selectExercise(candidate.name, candidate.targetReps);
                        showToast(`Ćwiczenie: ${candidate.name}`);
                        return;
                    }
                }

                // Jeśli wszystkie ukończone, przejdź po prostu do następnego z listy
                const next = plan.exercises[(currentIndex + 1) % plan.exercises.length];
                selectExercise(next.name, next.targetReps);
                showToast(`Wszystkie serie z planu wykonane!`);
            }

            function parsePlanText(rawText) {
                const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
                const exercises = [];

                lines.forEach(line => {
                    // Obsługa formatu: "Ćwiczenie | 4 | 8" lub "Ćwiczenie ; 4 ; 8"
                    if (line.includes('|') || line.includes(';')) {
                        const sep = line.includes('|') ? '|' : ';';
                        const parts = line.split(sep).map(p => p.trim());
                        const name = parts[0];
                        const targetSets = parseInt(parts[1], 10) || 3;
                        const targetReps = parseInt(parts[2], 10) || 8;
                        if (name) {
                            exercises.push({ name, targetSets, targetReps });
                        }
                        return;
                    }

                    // Obsługa formatu: "Wyciskanie sztangi 4x8" lub "Wyciskanie sztangi - 4 x 10"
                    const match = line.match(/^(.*?)[-\s:]+(\d+)\s*[xX*×]\s*(\d+)\s*$/);
                    if (match && match[1].trim()) {
                        exercises.push({
                            name: match[1].trim(),
                            targetSets: parseInt(match[2], 10) || 3,
                            targetReps: parseInt(match[3], 10) || 8
                        });
                        return;
                    }

                    // Zwykła nazwa ćwiczenia w linii
                    const cleanName = line.replace(/^[-*•\d.)+\s]+/, '').trim();
                    if (cleanName) {
                        exercises.push({
                            name: cleanName,
                            targetSets: 3,
                            targetReps: 8
                        });
                    }
                });

                return exercises;
            }

